{
    "layer": "top",
    "position": "top",
    "height": 46,
    "spacing": 8,

    "modules-left": ["hyprland/workspaces", "wlr/taskbar"],
    "modules-center": ["custom/mediawindow"],
    "modules-right": [
        "pulseaudio",
        "network",
        "battery",
        "clock",
        "custom/battery",
        "custom/power",
    ],

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 16,
        "tooltip-format": "{title}",
        "all-outputs": false,
        "active-first": true,
        "on-click": "activate",
        "on-click-middle": "close",
    },

    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": false,
        "format": "{name}",
    },

    "custom/mediawindow": {
        "exec": "~/.config/waybar/scripts/mediawindow.sh",
        "return-type": "json",
        "interval": 0.5,
        "max-length": 48,
        "tooltip": true,
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 mute",
        "format-icons": {
            "default": ["", "", ""],
        },
        "on-click": "~/.config/eww/scripts/open-audio.sh",
        "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip": true,
        "on-click": "nm-connection-editor",
    },

    "custom/battery": {
        "exec": "~/.config/waybar/scripts/battery.sh",
        "return-type": "json",
        "interval": 10,
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%d.%m.%Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    },

    "tray": {
        "spacing": 8,
    },

    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/powermenu.sh",
    },
}
